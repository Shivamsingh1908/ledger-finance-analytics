# Local development defaults to SQLite. Production uses the Npgsql connection string.
ConnectionStrings__DefaultConnection=Host=localhost;Database=finance;Username=postgres;Password=change-me;SSL Mode=Require;Trust Server Certificate=true
Database__Provider=Postgres
ASPNETCORE_ENVIRONMENT=Production
Jwt__Issuer=FinanceAnalyticsApi
Jwt__Audience=FinanceAnalyticsClient
Jwt__Key=replace-with-at-least-32-random-bytes
Cors__AllowedOrigins=https://<your-app>.vercel.app
Scheduler__Secret=replace-with-at-least-32-random-characters
Resend__ApiKey=
Resend__From=